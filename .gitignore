# ==========================================
# AI Voice Chatbot - Git Ignore Configuration
# ==========================================

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Python virtual environments
venv/
.venv/
env/

# Python distribution and build files
build/
dist/
*.egg-info/

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Downloaded AI models
models/
*.bin
*.pt
*.pth
*.onnx
*.safetensors
*.gguf

# Audio recordings and generated audio
audio/
*.wav
*.mp3
*.flac
*.ogg

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# IDE configuration
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Logs and temporary files
*.log
*.tmp
temp/
tmp/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Streamlit secrets
.streamlit/secrets.toml
